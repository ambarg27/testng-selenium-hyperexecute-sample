<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<!-- C06 branch: suite reduced to a SINGLE conditional test so each matrix group runs only it
     (fails only when variant=b). Full-suite execution therefore yields exactly one failed group. -->
<suite name="Linux: TestNG Execution using HyperExecute" thread-count="1" parallel="methods">
	<listeners>
		<listener class-name="org.uncommons.reportng.HTMLReporter"/>
		<listener class-name="org.uncommons.reportng.JUnitXMLReporter"/>
	</listeners>
	<test name="MatrixCond">
			<classes>
				<class name="MatrixCond" />
			</classes>
	</test>
</suite>
